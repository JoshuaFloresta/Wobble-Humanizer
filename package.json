{
  "name": "humaninzer",
  "version": "1.0.0",
  "private": true,
  "description": "HumanInzer - deterministic, explainable text paraphrasing, readability and tone workbench (MERN, self-hosted, personal use).",
  "workspaces": [
    "engine",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "test:offline": "npm run test:offline --workspace client",
    "test:render": "npm run test:render --workspace client",
    "test:all": "npm run test && npm run test:offline",
    "test:storage": "npm run test:storage --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
