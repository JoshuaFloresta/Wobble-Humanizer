# HumanInzer configuration. Every value has a working default -- copy this to
# .env only if you want to change something.

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Database (optional) -------------------------------------------------
# History is stored in your browser (IndexedDB) and needs no database at all,
# which is why persistence is off by default.
#
# Turn it on only if you want history shared between browsers or surviving a
# clear of site data. With PERSISTENCE=true and no MONGODB_URI, the server
# downloads and runs an embedded MongoDB (~60 MB binary, data in .data/mongo).
PERSISTENCE=false

# Point at Atlas or a local mongod instead of the embedded one:
#   MONGODB_URI=mongodb://127.0.0.1:27017
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=humaninzer
MONGODB_DATA_PATH=

# --- Engine ---------------------------------------------------------------
PARAPHRASE_ENGINE=rules
MAX_INPUT_CHARS=20000

# --- Client ---------------------------------------------------------------
CORS_ORIGIN=*
# Where the Vite dev server proxies /api during development.
VITE_API_TARGET=http://localhost:4000
